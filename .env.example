# Copy to .env for local dev (never commit .env itself — it's gitignored).
# Set the same keys in the Vercel dashboard (Production + Preview) for deployment.

# Neon Postgres connection string (pooled). Get one at https://neon.tech or
# via the claimable-postgres flow (https://pg.new).
DATABASE_URL=

# Single shared admin login for /admin.
ADMIN_USERNAME=admin
# Generate with: node -e "console.log(require('bcryptjs').hashSync('yourPassword', 10))"
ADMIN_PASSWORD_HASH=

# Random secret used to sign admin session cookies (JWT). Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Auto-populated when a Vercel Blob store is created/linked to the project
# (vercel dashboard -> Storage -> Blob, or `vercel env pull`).
BLOB_READ_WRITE_TOKEN=
